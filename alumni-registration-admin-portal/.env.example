# Same PostgreSQL database as alumni_2026 — this app never runs migrations,
# only `prisma generate` against the copied schema.prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/svce_alumni?schema=public"

# SMTP used to send membership card / entry pass emails
EMAIL_HOST="smtp.example.com"
EMAIL_PORT="587"
EMAIL_USER="alumni@example.com"
EMAIL_PASSWORD="change-me"
EMAIL_FROM="SVCE Alumni <alumni@example.com>"

# Single shared admin password + a long random secret used to sign admin
# session cookies (JWT). Generate ADMIN_SESSION_SECRET with e.g.
# `openssl rand -base64 32`.
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"

# Public origin of THIS app — used to build absolute URLs for generated
# membership card / entry pass images.
ADMIN_PUBLIC_APP_URL="http://localhost:3001"

# Where generated membership cards / entry passes are written, relative to /public
DOCUMENT_STORAGE_DIR="documents"
