# PostgreSQL connection used by Prisma (alumni_2026 app — owns the migrations)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/svce_alumni?schema=public"

# SMTP used to send the registration acknowledgement email
EMAIL_HOST="smtp.example.com"
EMAIL_PORT="587"
EMAIL_USER="alumni@example.com"
EMAIL_PASSWORD="change-me"
EMAIL_FROM="SVCE Alumni <alumni@example.com>"

# Public origin of THIS app (alumni_2026) — used to build absolute photo URLs
# that the admin portal (a different origin/port) can load directly.
PUBLIC_APP_URL="http://localhost:3000"

# Where uploaded alumni photos are written, relative to /public
PHOTO_STORAGE_DIR="uploads/photos"

# Alumni ID format — e.g. SVCE-ALM-000001
ALUMNI_ID_PREFIX="SVCE-ALM"
ALUMNI_ID_PADDING="6"
